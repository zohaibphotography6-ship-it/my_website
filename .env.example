# ───────────── Choose ONE provider — easiest is CallMeBot ─────────────

# ────────── A) CallMeBot (free, no Meta setup) ──────────
# 1. On the owner's phone, save +34 644 51 95 23 as a WhatsApp contact.
# 2. WhatsApp it the exact text: I allow callmebot to send me messages
# 3. It replies with your personal API key — paste it below.
CALLMEBOT_APIKEY=<CALLMEBOT_API_KEY>

# Owner number in digits-only E.164 form (no '+').
# 03135833852 in Pakistan = 923135833852
WHATSAPP_OWNER_NUMBER=923135833852

# ────────── B) Meta WhatsApp Cloud API (optional, full automation) ──────────
# Uncomment if you want both owner + customer auto-delivery via Meta.
# WHATSAPP_TOKEN=<META_GRAPH_API_TOKEN>
# WHATSAPP_PHONE_NUMBER_ID=<META_PHONE_NUMBER_ID>
# WHATSAPP_GRAPH_VERSION=v20.0
# WHATSAPP_CUSTOMER_TEMPLATE=<APPROVED_TEMPLATE_NAME>
# WHATSAPP_CUSTOMER_LANG=en_US
